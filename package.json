{
  "name": "dsh-inline-images",
  "description": "对话内联图片: LLM 以 ![路径](路径) 附图, 前端在消息正文内渲染本地图片, 会话日志零污染, 支持 9 种格式, 点击放大灯箱, 可调尺寸",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
